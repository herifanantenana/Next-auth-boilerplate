{
  "semi": true,
  "tabWidth": 2,
  "useTabs": true,
  "singleQuote": false,
  "printWidth": 120,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "trailingComma": "all",
  "jsxBracketSameLine": false,
  "plugins": ["prettier-plugin-tailwindcss"],
  "pluginSearchDirs": ["."]
}
